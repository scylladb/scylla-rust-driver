# Single source of truth for the default ScyllaDB version used in testing.
#
# It is used both by the docker-compose test cluster
# (test/cluster/docker-compose.yml) and by the CCM tests.
#
# This file is kept up to date automatically by Renovate.
#
# The value must be a full, three-component version (e.g. 2026.2.2), not a
# truncated one (e.g. 2026.2). A truncated version is accepted by CCM, but it
# makes every single ccm invocation - even against an already-running cluster -
# query AWS to resolve the latest patch number, which slows the tests down a lot.
#
# This file may only contain `#` comments and bare KEY=VALUE lines: no `export`,
# no shell syntax and no quotes around the value.
SCYLLA_VERSION=2026.2.5
